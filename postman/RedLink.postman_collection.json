{
  "info": {
    "name": "RedLink API",
    "description": "Every RedLink endpoint. Start with **1. Sign in**: each login request saves its token in the `token` collection variable, and every other request sends it as `Authorization: Bearer {{token}}` (set once on the collection). Signing in as another user replaces the token.\n\nThe sign-in requests use the sample accounts from the backend's sample data (`redlink.seed.enabled=true`) and the `seedPassword` variable. Set it in the **RedLink Local** environment (postman/RedLink-Local.postman_environment.json) to your `redlink.seed.password`.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      { "key": "token", "value": "{{token}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api", "description": "Overridden by the environment's baseUrl when one is selected" },
    { "key": "token", "value": "", "description": "Set by the sign-in and registration requests" },
    { "key": "donorId", "value": "1", "description": "Set by List donors (first donor in the list)" },
    { "key": "hospitalId", "value": "1", "description": "Set by Pending queue (oldest pending hospital) or All hospitals" },
    { "key": "approvedHospitalId", "value": "1", "description": "Set by All hospitals (first approved hospital); used by Add staff user" },
    { "key": "userId", "value": "1", "description": "Set by Search users (first result) and Add staff user" },
    { "key": "requestId", "value": "1", "description": "Set by Post a request" },
    { "key": "acceptRequestId", "value": "1", "description": "Set by Incoming requests (first unanswered)" },
    { "key": "declineRequestId", "value": "1", "description": "Set by Incoming requests (second unanswered)" },
    { "key": "notificationId", "value": "1", "description": "Set by My notifications (first unread)" },
    { "key": "adminRequestId", "value": "1", "description": "Set by All requests (9), the newest request" }
  ],
  "item": [
    {
      "name": "1. Sign in",
      "description": "Run one of these first. The token is saved automatically and used by every other request.",
      "item": [
        {
          "name": "Login as admin",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Signed in\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"token\", body.token);",
              "console.log(`Signed in as ${body.user.email} (${body.user.role}). Token saved.`);"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@seed.redlink.lk\",\n  \"password\": \"{{seedPassword}}\",\n  \"rememberMe\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as hospital staff (approved)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Signed in\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"token\", body.token);",
              "console.log(`Signed in as ${body.user.email} (${body.user.role}, hospital ${body.user.hospitalStatus}). Token saved.`);"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff.approved@seed.redlink.lk\",\n  \"password\": \"{{seedPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as hospital staff (pending)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Signed in\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"token\", body.token);",
              "console.log(`Signed in as ${body.user.email} (${body.user.role}, hospital ${body.user.hospitalStatus}). Token saved.`);"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff.pending@seed.redlink.lk\",\n  \"password\": \"{{seedPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login as donor",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Signed in\", () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"token\", body.token);",
              "console.log(`Signed in as ${body.user.email} (${body.user.role}). Token saved.`);"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"kamal.perera@seed.redlink.lk\",\n  \"password\": \"{{seedPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Current user (me)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/me", "host": ["{{baseUrl}}"], "path": ["auth", "me"] }
          }
        },
        {
          "name": "Change own password",
          "request": {
            "description": "Changes the password of whoever is signed in. For a sample account, this replaces redlink.seed.password for that user only. Every older token stops working; the new one in the response is saved for the next requests.",
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{seedPassword}}\",\n  \"newPassword\": \"CHOOSE_A_NEW_PASSWORD\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/me/password", "host": ["{{baseUrl}}"], "path": ["auth", "me", "password"] }
          },
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set(\"token\", pm.response.json().token);",
              "  console.log('Password changed. Older tokens no longer work; the new token is saved.');",
              "}"
            ] } }
          ]
        },
        {
          "name": "Register donor",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"token\", body.token);",
              "console.log(`Registered and signed in as ${body.user.email}. Token saved.`);"
            ] } }
          ],
          "request": {
            "description": "Uses {{$timestamp}} so the email is new every time.",
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Postman Donor\",\n  \"email\": \"donor-{{$timestamp}}@example.lk\",\n  \"phone\": \"0771234567\",\n  \"password\": \"Passw0rd!Test\",\n  \"bloodGroup\": \"O+\",\n  \"dateOfBirth\": \"1995-04-12\",\n  \"city\": \"Colombo\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register/donor", "host": ["{{baseUrl}}"], "path": ["auth", "register", "donor"] }
          }
        },
        {
          "name": "Register hospital",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set(\"token\", body.token);",
              "console.log(`Registered and signed in as ${body.user.email} (hospital ${body.user.hospitalStatus}). Token saved.`);"
            ] } }
          ],
          "request": {
            "description": "Creates a PENDING hospital and its first staff user. Uses {{$timestamp}} so the registration number and email are new every time.",
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospital\": {\n    \"name\": \"Postman Hospital\",\n    \"registrationNo\": \"REG-{{$timestamp}}\",\n    \"address\": \"1 Test Rd\",\n    \"city\": \"Colombo\",\n    \"phone\": \"0115577111\"\n  },\n  \"staff\": {\n    \"fullName\": \"Postman Staff\",\n    \"email\": \"staff-{{$timestamp}}@example.lk\",\n    \"phone\": \"0712345678\",\n    \"password\": \"Passw0rd!Test\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/register/hospital", "host": ["{{baseUrl}}"], "path": ["auth", "register", "hospital"] }
          }
        }
      ]
    },
    {
      "name": "3. Donors (admin)",
      "description": "Sign in as admin first; other roles get 403.",
      "item": [
        {
          "name": "List donors",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const donors = pm.response.json();",
              "if (donors.length > 0) {",
              "  pm.collectionVariables.set(\"donorId\", donors[0].id);",
              "}"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/donors", "host": ["{{baseUrl}}"], "path": ["donors"] }
          }
        },
        {
          "name": "Get donor by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/donors/{{donorId}}", "host": ["{{baseUrl}}"], "path": ["donors", "{{donorId}}"] }
          }
        },
        {
          "name": "List donors without a token (401)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 401\", () => pm.response.to.have.status(401));"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/donors", "host": ["{{baseUrl}}"], "path": ["donors"] }
          }
        }
      ]
    },
    {
      "name": "4. Admin: hospitals",
      "description": "Sign in as admin first; other roles get 403. Run Pending queue first: it saves the oldest pending hospital as {{hospitalId}}. A decision is final, so approving or rejecting the same hospital twice gives 409.",
      "item": [
        {
          "name": "Pending queue",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const hospitals = pm.response.json();",
              "if (hospitals.length > 0) {",
              "  pm.collectionVariables.set(\"hospitalId\", hospitals[0].id);",
              "  console.log(`Saved hospitalId ${hospitals[0].id} (${hospitals[0].name}).`);",
              "} else {",
              "  console.log('No pending hospitals. Run Register hospital in 2. Auth to make one.');",
              "}"
            ] } }
          ],
          "request": {
            "description": "Hospitals waiting for approval, oldest first.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/hospitals?status=PENDING",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "hospitals"],
              "query": [{ "key": "status", "value": "PENDING", "description": "PENDING, APPROVED or REJECTED; leave out for all" }]
            }
          }
        },
        {
          "name": "All hospitals",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const approved = pm.response.json().find((h) => h.status === 'APPROVED');",
              "if (approved) {",
              "  pm.collectionVariables.set(\"approvedHospitalId\", approved.id);",
              "  console.log(`Saved approvedHospitalId ${approved.id} (${approved.name}).`);",
              "}"
            ] } }
          ],
          "request": {
            "description": "Every hospital, newest first.",
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/hospitals", "host": ["{{baseUrl}}"], "path": ["admin", "hospitals"] }
          }
        },
        {
          "name": "Hospital details",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ] } }
          ],
          "request": {
            "description": "Address, phone, staff contacts, and who decided and when.",
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/admin/hospitals/{{hospitalId}}", "host": ["{{baseUrl}}"], "path": ["admin", "hospitals", "{{hospitalId}}"] }
          }
        },
        {
          "name": "Approve hospital",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Approved\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('APPROVED');",
              "});"
            ] } }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/hospitals/{{hospitalId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "hospitals", "{{hospitalId}}", "status"] }
          }
        },
        {
          "name": "Reject hospital",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Rejected\", () => {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('REJECTED');",
              "});"
            ] } }
          ],
          "request": {
            "description": "The reason is required (max 500 characters) and is shown to the hospital's staff.",
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"reason\": \"Registration number not found in the Ministry of Health register.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/hospitals/{{hospitalId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "hospitals", "{{hospitalId}}", "status"] }
          }
        },
        {
          "name": "Reject without a reason (400)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 400 on reason\", () => {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().fieldErrors[0].field).to.eql('reason');",
              "});"
            ] } }
          ],
          "request": {
            "description": "Run on a PENDING hospital; an already-decided one gives 409 first.",
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/hospitals/{{hospitalId}}/status", "host": ["{{baseUrl}}"], "path": ["admin", "hospitals", "{{hospitalId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "5. Admin: users",
      "description": "Sign in as admin first; other roles get 403. Run All hospitals in 4 first, so Add staff user has an approved hospital.",
      "item": [
        {
          "name": "Search users",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const users = pm.response.json();",
              "if (users.length > 0) {",
              "  pm.collectionVariables.set(\"userId\", users[0].id);",
              "  console.log(`Saved userId ${users[0].id} (${users[0].email}).`);",
              "}"
            ] } }
          ],
          "request": {
            "description": "Newest first, at most 200. Both parameters are optional; q matches part of the name or email, ignoring case.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/users?role=DONOR&q=kamal",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "users"],
              "query": [
                { "key": "role", "value": "DONOR", "description": "ADMIN, HOSPITAL_STAFF or DONOR" },
                { "key": "q", "value": "kamal", "description": "Part of a name or email" }
              ]
            }
          }
        },
        {
          "name": "Add staff user",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "const user = pm.response.json();",
              "pm.collectionVariables.set(\"userId\", user.id);",
              "console.log(`Added ${user.email} to ${user.hospitalName}. They sign in with the temporary password and must change it.`);"
            ] } }
          ],
          "request": {
            "description": "Adds HOSPITAL_STAFF to an APPROVED hospital ({{approvedHospitalId}}). Uses {{$timestamp}} so the email is new every time.",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hospitalId\": {{approvedHospitalId}},\n  \"fullName\": \"Postman Colleague\",\n  \"email\": \"colleague-{{$timestamp}}@example.lk\",\n  \"phone\": \"0712345678\",\n  \"temporaryPassword\": \"Temp-Pass-2026\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/admin/users", "host": ["{{baseUrl}}"], "path": ["admin", "users"] }
          }
        }
      ]
    },
    {
      "name": "6. Blood requests",
      "description": "Sign in as approved hospital staff first (1. Sign in). Post a request saves requestId for the others.",
      "item": [
        {
          "name": "Post a request",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// Needed by this time tomorrow, as an ISO timestamp",
              "pm.variables.set(\"neededBy\", new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString());"
            ] } },
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"Never notifies more than the matches\", () => pm.expect(body.notifiedCount).to.be.at.most(body.matchCount));",
              "pm.collectionVariables.set(\"requestId\", body.request.id);",
              "console.log(`#${body.request.reference} is live: notified ${body.notifiedCount} of ${body.matchCount} matches.`);"
            ] } }
          ],
          "request": {
            "description": "LOW × 2 units notifies up to 4 donors (units × urgency multiplier, capped at 25).",
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodGroup\": \"A+\",\n  \"unitsNeeded\": 2,\n  \"urgency\": \"LOW\",\n  \"city\": \"Colombo\",\n  \"neededBy\": \"{{neededBy}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] }
          }
        },
        {
          "name": "Request details",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}"] }
          }
        },
        {
          "name": "Ranked matches",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "const matches = pm.response.json();",
              "pm.test(\"Exact group before substitutes\", () => {",
              "  const firstSubstitute = matches.findIndex(m => !m.exactMatch);",
              "  pm.expect(firstSubstitute === -1 || matches.slice(firstSubstitute).every(m => !m.exactMatch)).to.be.true;",
              "});"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/requests/{{requestId}}/matches", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "matches"] }
          }
        },
        {
          "name": "Matches: O- donors only",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Only O-\", () => pm.response.json().forEach(m => pm.expect(m.bloodGroup).to.eql(\"O-\")));"
            ] } }
          ],
          "request": {
            "description": "Write O+ as O%2B in a URL: an unencoded + means a space.",
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/matches?bloodGroup=O-",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "matches"],
              "query": [{ "key": "bloodGroup", "value": "O-" }]
            }
          }
        },
        {
          "name": "Matches: Colombo only",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"All in the same city\", () => pm.response.json().forEach(m => pm.expect(m.sameCity).to.be.true));"
            ] } }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/requests/{{requestId}}/matches?city=colombo",
              "host": ["{{baseUrl}}"],
              "path": ["requests", "{{requestId}}", "matches"],
              "query": [{ "key": "city", "value": "colombo" }]
            }
          }
        },
        {
          "name": "Post as a pending hospital (403)",
          "event": [
            { "listen": "prerequest", "script": { "type": "text/javascript", "exec": [
              "// Signs in as the pending hospital's staff for this request only; the saved token is untouched",
              "pm.variables.set(\"neededBy\", new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString());",
              "pm.sendRequest({",
              "  url: pm.variables.replaceIn(\"{{baseUrl}}/auth/login\"),",
              "  method: \"POST\",",
